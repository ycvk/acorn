[Unit]
Description=Acorn self-hosted agent backend
Documentation=https://github.com/ycvk/acorn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
EnvironmentFile=-/root/.acorn/acorn.env
WorkingDirectory=/srv/acorn/workspace
ExecStart=/opt/acorn/acorn serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/.acorn /srv/acorn/workspace

[Install]
WantedBy=multi-user.target
