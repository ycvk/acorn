# The agent's workstation. The installer builds it on the server; the Acorn
# binary is mounted read-only at /usr/local/bin/acorn and serves the
# workstation API. /home/agent is a named volume that survives rebuilds.
FROM docker.io/library/debian:trixie-slim

ARG TARGETARCH
# BrowserSkill (https://github.com/Tencent/BrowserSkill): the bsk CLI drives a
# browser through its extension. Versions and checksums are pinned.
ARG BSK_VERSION=0.3.2
ARG BSK_SHA256_AMD64=73e3948ad2232111661729c25e6c762eda7bd5c2320fa2593fe55c9855790631
ARG BSK_SHA256_ARM64=625de29561a98b245ef712d13c273c5de744e4610a7bbf1999ff3b279d2220cf
ARG BSK_EXTENSION_SHA256=9f543214a0ff5f0f2ce213dd8c5300111dba0ab757fa542a3f61b5636132c24e
# uv (https://github.com/astral-sh/uv) runs the Python MCP servers skill
# packages declare with uvx, and Node.js LTS the npx ones; Debian's Node.js
# is older than current npm packages need.
ARG UV_VERSION=0.13.1
ARG UV_SHA256_AMD64=eadd9d27c134ab5ac1ffd4473b97a741407f3ea238288f03121fc4deddf90220
ARG UV_SHA256_ARM64=9041c73c99fdc5892cf128140beb354eca9231d502068cc36e6cb53a8e59ad14
ARG NODE_VERSION=24.22.1
ARG NODE_SHA256_AMD64=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
ARG NODE_SHA256_ARM64=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e

# Xvfb runs as the agent user, which cannot create /tmp/.X11-unix itself.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		bash bc ca-certificates chromium curl file fonts-noto-cjk gawk git jq less openssh-client \
		procps python3 python3-pip python3-venv rsync sudo unzip wget xdotool xvfb xz-utils zip \
	&& rm -rf /var/lib/apt/lists/* \
	&& useradd --create-home --uid 1000 --shell /bin/bash agent \
	&& echo 'agent ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/agent \
	&& chmod 0440 /etc/sudoers.d/agent \
	&& install -d -m 1777 /tmp/.X11-unix

RUN set -eu; \
	case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
		amd64) target=x86_64-unknown-linux-musl; sum=$BSK_SHA256_AMD64 ;; \
		arm64) target=aarch64-unknown-linux-musl; sum=$BSK_SHA256_ARM64 ;; \
		*) echo "unsupported architecture" >&2; exit 1 ;; \
	esac; \
	base=https://github.com/Tencent/BrowserSkill/releases/download; \
	curl -fsSL -o /tmp/bsk.tar.gz "$base/cli-v$BSK_VERSION/bsk-v$BSK_VERSION-$target.tar.gz"; \
	echo "$sum  /tmp/bsk.tar.gz" | sha256sum -c -; \
	mkdir /tmp/bsk && tar -xzf /tmp/bsk.tar.gz -C /tmp/bsk; \
	install -m 0755 "$(find /tmp/bsk -type f -name bsk)" /usr/local/bin/bsk; \
	curl -fsSL -o /tmp/extension.zip "$base/ext-v$BSK_VERSION/browser-skill-extension-v$BSK_VERSION-chrome.zip"; \
	echo "$BSK_EXTENSION_SHA256  /tmp/extension.zip" | sha256sum -c -; \
	mkdir -p /opt/browserskill && unzip -q /tmp/extension.zip -d /opt/browserskill/extension; \
	rm -rf /tmp/bsk /tmp/bsk.tar.gz /tmp/extension.zip

RUN set -eu; \
	case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
		amd64) target=x86_64-unknown-linux-gnu; sum=$UV_SHA256_AMD64 ;; \
		arm64) target=aarch64-unknown-linux-gnu; sum=$UV_SHA256_ARM64 ;; \
		*) echo "unsupported architecture" >&2; exit 1 ;; \
	esac; \
	curl -fsSL -o /tmp/uv.tar.gz "https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-$target.tar.gz"; \
	echo "$sum  /tmp/uv.tar.gz" | sha256sum -c -; \
	tar -xzf /tmp/uv.tar.gz -C /tmp; \
	install -m 0755 "/tmp/uv-$target/uv" "/tmp/uv-$target/uvx" /usr/local/bin/; \
	rm -rf /tmp/uv.tar.gz "/tmp/uv-$target"

RUN set -eu; \
	case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
		amd64) target=linux-x64; sum=$NODE_SHA256_AMD64 ;; \
		arm64) target=linux-arm64; sum=$NODE_SHA256_ARM64 ;; \
		*) echo "unsupported architecture" >&2; exit 1 ;; \
	esac; \
	curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-$target.tar.xz"; \
	echo "$sum  /tmp/node.tar.xz" | sha256sum -c -; \
	mkdir -p /opt/node && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; \
	ln -s /opt/node/bin/node /opt/node/bin/npm /opt/node/bin/npx /usr/local/bin/; \
	rm /tmp/node.tar.xz

# The mode is set here so the image does not depend on the umask the release
# package was built with.
COPY --chmod=0755 entrypoint.sh /usr/local/lib/acorn/workstation-entrypoint

# The workstation pins bsk, and the daemons are started by the entrypoint.
ENV LANG=C.UTF-8 BSK_AUTO_UPDATE=off BSK_AUTO_START=0
USER agent
WORKDIR /home/agent
EXPOSE 7810
ENTRYPOINT ["/usr/local/lib/acorn/workstation-entrypoint"]
